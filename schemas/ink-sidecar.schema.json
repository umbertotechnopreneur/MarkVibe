{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarkVibe ink sidecar — version 1",
  "description": "Bounded logical-coordinate annotations. The runtime also limits total points to 20,000 and UTF-8 file size to 1 MiB. New notes use after-block placement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "document",
    "annotations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "document": {
      "$ref": "#/$defs/document"
    },
    "annotations": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/annotation"
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:\\u0000-\\u001f\\u007f]+$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "hashAlgorithm",
        "contentHash"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "hashAlgorithm": {
          "const": "sha256-utf8-exact"
        },
        "contentHash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "headingId",
        "blockId",
        "quote",
        "prefix",
        "suffix",
        "sourceLine"
      ],
      "properties": {
        "kind": {
          "enum": [
            "section",
            "text"
          ]
        },
        "headingId": {
          "type": "string",
          "maxLength": 256
        },
        "blockId": {
          "type": "string",
          "maxLength": 128
        },
        "quote": {
          "type": "string",
          "maxLength": 512
        },
        "prefix": {
          "type": "string",
          "maxLength": 128
        },
        "suffix": {
          "type": "string",
          "maxLength": 128
        },
        "sourceLine": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "pressure",
        "elapsedMs"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "pressure": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "elapsedMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        }
      }
    },
    "stroke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color",
        "width",
        "tool",
        "points"
      ],
      "properties": {
        "color": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}(?:[a-fA-F0-9]{2})?$"
        },
        "width": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 64
        },
        "tool": {
          "enum": [
            "pen",
            "highlighter"
          ]
        },
        "points": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/point"
          }
        }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "anchor",
        "placement",
        "canvas",
        "strokes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$"
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        },
        "placement": {
          "enum": [
            "overlay",
            "after-block"
          ]
        },
        "canvas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height",
            "coordinateSpace"
          ],
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10000
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10000
            },
            "coordinateSpace": {
              "const": "logical"
            }
          }
        },
        "strokes": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/stroke"
          }
        }
      }
    }
  }
}
