{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarkVibe document sticky notes",
  "description": "At most 1 MiB of UTF-8 JSON. Canonical workspace paths and unique note ids are additionally enforced by NotesCodec.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentPath", "documentHash", "notes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "documentPath": { "$ref": "#/$defs/documentPath" },
    "documentHash": { "$ref": "#/$defs/hash" },
    "notes": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/note" },
          { "required": ["anchor"], "properties": { "anchor": { "$ref": "#/$defs/anchor" } } }
        ]
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": {
      "type": "string", "minLength": 1, "maxLength": 1024,
      "description": "NFC canonical relative workspace path, without ignored directories or dot segments.",
      "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)[^\\\\:\\u0000-\\u001f\\u007f]+$"
    },
    "documentPath": {
      "allOf": [
        { "$ref": "#/$defs/path" },
        { "pattern": "\\.[mM](?:[dD]|[aA][rR][kK][dD][oO][wW][nN]|[dD][oO][wW][nN])$" }
      ]
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "kind", "fragmentHash", "quote", "context"],
      "properties": {
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "fragmentHash": { "$ref": "#/$defs/hash" },
        "quote": { "type": "string", "maxLength": 512, "pattern": "^[^\\u0000]*$" },
        "context": { "type": "string", "maxLength": 512, "pattern": "^[^\\u0000]*$" },
        "assetPath": { "anyOf": [{ "const": "" }, { "$ref": "#/$defs/path" }], "default": "" },
        "u": { "type": ["number", "null"], "minimum": 0, "maximum": 1, "default": null },
        "v": { "type": ["number", "null"], "minimum": 0, "maximum": 1, "default": null },
        "documentHash": { "anyOf": [{ "const": "" }, { "$ref": "#/$defs/hash" }], "default": "" }
      },
      "allOf": [
        {
          "if": { "required": ["u"], "properties": { "u": { "type": "number" } } },
          "then": { "required": ["v"], "properties": { "v": { "type": "number" } } }
        },
        {
          "if": { "required": ["v"], "properties": { "v": { "type": "number" } } },
          "then": { "required": ["u"], "properties": { "u": { "type": "number" } } }
        }
      ]
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "body", "color", "icon", "x", "y"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_-]+$" },
        "title": { "type": "string", "maxLength": 128, "pattern": "^[^\\u0000]*$" },
        "body": { "type": "string", "maxLength": 16384, "pattern": "^[^\\u0000]*$", "description": "Markdown source; additionally limited to 16 KiB UTF-8 by NotesCodec. Render through the restricted sanitized note renderer." },
        "color": { "enum": ["#5b557f", "#ff4141", "#ff7020", "#ffc400", "#00bd55", "#0085ff", "#914bff", "#ff59ad", "#748094", "#d64578", "#e88263", "#84ad18", "#008f83", "#009fbd", "#5865d9", "#a56d46"] },
        "icon": { "enum": ["file", "folder", "coin", "book", "graduation", "pencil", "pen-tool", "code", "terminal", "music", "flower", "palette", "stethoscope", "sparkles", "briefcase", "chart", "kettlebell", "dumbbell", "notebook", "balance", "moon", "plane", "globe", "heart"] },
        "x": { "type": "number", "minimum": -100000, "maximum": 100000 },
        "y": { "type": "number", "minimum": -100000, "maximum": 100000 },
        "width": { "type": "number", "minimum": 160, "maximum": 1200, "default": 240 },
        "height": { "type": "number", "minimum": 120, "maximum": 1200, "default": 220 },
        "zIndex": { "type": "integer", "minimum": 0, "maximum": 1000000, "default": 0 },
        "anchor": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/anchor" }], "default": null }
      }
    }
  }
}
