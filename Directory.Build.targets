<Project>
  <!-- External JavaScript inputs are outside the Browser project directory. Always enter
       MSBuild for both hosts: the browser checks its fingerprint and the desktop stages
       updated assets even when the managed assemblies themselves have not changed. -->
  <PropertyGroup Condition="'$(BuildingInsideVisualStudio)' == 'true' and ('$(MSBuildProjectName)' == 'MarkVibe.Browser' or '$(MSBuildProjectName)' == 'MarkVibe.Windows')">
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>

  <!-- Reuse the locked npm preparation only when the generated client is absent or stale.
       Design-time evaluation, command-line builds and executable checks remain unchanged. -->
  <Target Name="PrepareVisualStudioClient"
          BeforeTargets="RequireClientBundle"
          Condition="'$(BuildingInsideVisualStudio)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(MSBuildProjectName)' == 'MarkVibe.Browser'">
    <Exec Command="node &quot;$(MSBuildThisFileDirectory)scripts/check-client-bundle.mjs&quot; --configuration &quot;$(Configuration)&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          IgnoreExitCode="true"
          StandardOutputImportance="Low"
          StandardErrorImportance="Low">
      <Output TaskParameter="ExitCode" PropertyName="_MarkVibeClientBundleExitCode" />
    </Exec>
    <Exec Condition="'$(_MarkVibeClientBundleExitCode)' != '0'"
          Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)scripts/prepare-client.ps1&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)" />
  </Target>
</Project>
