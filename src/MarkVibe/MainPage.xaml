<UserControl x:Class="MarkVibe.MainPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:MarkVibe.Controls"
 FontFamily="Segoe UI" Foreground="{StaticResource ShellText}">
 <Grid Background="{StaticResource ShellBackground}">
  <Grid.RowDefinitions>
   <RowDefinition Height="64" /><RowDefinition Height="58" /><RowDefinition Height="*" /><RowDefinition Height="34" />
  </Grid.RowDefinitions>
  <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource ShellBorder}" BorderThickness="0,0,0,1">
   <Grid Margin="12,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="≡" Style="{StaticResource ToolbarButton}" Click="ToggleSidebar" AutomationProperties.Name="Toggle document sidebar" ToolTipService.ToolTip="Toggle sidebar" />
     <Border x:Name="BrandBadge" Background="{StaticResource Accent}" CornerRadius="10" Width="34" Height="34" Margin="10,0">
      <TextBlock Text="M" Foreground="White" FontWeight="Bold" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" />
     </Border>
     <TextBlock x:Name="BrandName" Text="MarkVibe" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0" />
     <Button x:Name="BackButton" Content="←" Style="{StaticResource ToolbarButton}" Click="Back" IsEnabled="False" AutomationProperties.Name="Back" ToolTipService.ToolTip="Back · Alt+Left" />
     <Button x:Name="ForwardButton" Content="→" Style="{StaticResource ToolbarButton}" Click="Forward" IsEnabled="False" AutomationProperties.Name="Forward" ToolTipService.ToolTip="Forward · Alt+Right" />
    </StackPanel>
    <StackPanel x:Name="TitlePanel" Grid.Column="1" VerticalAlignment="Center" Margin="24,0,16,0">
     <TextBlock x:Name="DocumentTitle" Text="Your documents, beautifully connected" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
     <TextBlock x:Name="Breadcrumb" Text="Choose a file or explore the sample workspace" FontSize="11" Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="OpenFileButton" Content="Open file" Style="{StaticResource ToolbarButton}" Click="OpenFiles" AutomationProperties.Name="Open Markdown files and related resources" />
     <Button x:Name="OpenFolderButton" Content="Open folder" Style="{StaticResource ToolbarButton}" Click="OpenFolder" />
     <Button x:Name="SettingsButton" Content="◐" Style="{StaticResource ToolbarButton}" Click="ToggleSettings" AutomationProperties.Name="Appearance and settings" ToolTipService.ToolTip="Appearance and settings" />
     <Button x:Name="AboutButton" Content="ⓘ" Style="{StaticResource ToolbarButton}" Click="ShowAbout" AutomationProperties.Name="About MarkVibe" ToolTipService.ToolTip="About MarkVibe" />
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1" Margin="15,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Button x:Name="ReadButton" Content="Read" Style="{StaticResource ViewButton}" Click="ReadView" />
    <Button x:Name="SourceButton" Content="Source" Style="{StaticResource ViewButton}" Click="SourceViewClick" />
    <Button x:Name="SplitButton" Content="Split" Style="{StaticResource ViewButton}" Click="SplitView" />
    <Button x:Name="MapButton" Content="Map" Style="{StaticResource ViewButton}" Click="MapViewClick" />
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <TextBox x:Name="SearchBox" Width="220" Height="36" Margin="8,0" VerticalContentAlignment="Center" Padding="10,5" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource ShellBorder}" Foreground="{StaticResource ShellText}" TextChanged="SearchChanged" AutomationProperties.Name="Search workspace documents" ToolTipService.ToolTip="Search documents · Ctrl+K" />
    <Button x:Name="ZoomOutButton" Content="−" Style="{StaticResource ViewButton}" Click="ZoomOut" AutomationProperties.Name="Decrease reading size" />
    <TextBlock x:Name="ZoomLabel" Text="100%" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" Margin="4,0" />
    <Button x:Name="ZoomInButton" Content="+" Style="{StaticResource ViewButton}" Click="ZoomIn" AutomationProperties.Name="Increase reading size" />
   </StackPanel>
  </Grid>
  <Grid x:Name="WorkspaceGrid" Grid.Row="2" Margin="12,0,12,8">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="248" /><ColumnDefinition x:Name="SidebarDividerColumn" Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <Border x:Name="Sidebar" CornerRadius="12" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource ShellBorder}" BorderThickness="1">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <StackPanel Margin="17,18,17,8">
      <TextBlock x:Name="WorkspaceName" Text="Sample workspace" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="WorkspaceMode" Text="Explore a few connected pages" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,5,0,0" TextWrapping="Wrap" />
     </StackPanel>
     <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,8">
      <Button Content="Pages" Style="{StaticResource ViewButton}" Click="ShowPages" />
      <Button Content="Outline" Style="{StaticResource ViewButton}" Click="ShowOutline" />
     </StackPanel>
     <ListBox x:Name="DocumentList" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="DocumentSelected" Margin="8,0,8,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Workspace documents">
      <ListBox.ItemTemplate><DataTemplate>
       <StackPanel Margin="6,8" ToolTipService.ToolTip="{Binding Introduction}">
        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Path}" FontSize="10" Opacity="0.8" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
       </StackPanel>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <ListBox x:Name="OutlineList" Grid.Row="2" Background="Transparent" BorderThickness="0" Visibility="Collapsed" Margin="8,0,8,8" SelectionChanged="HeadingSelected" AutomationProperties.Name="Current document outline">
      <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="7,8">
       <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" />
       <TextBlock Text="{Binding Level, StringFormat='Heading {0}'}" Opacity="0.8" FontSize="10" Margin="0,3,0,0" />
      </StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock x:Name="IndexLabel" Grid.Row="3" Text="Your documents stay on this device" Margin="18,12" FontSize="10" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" />
    </Grid>
   </Border>
   <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="8" HorizontalAlignment="Center" Background="Transparent" />
   <Border x:Name="DocumentPanel" Grid.Column="2" CornerRadius="12" BorderBrush="{StaticResource ShellBorder}" BorderThickness="1" Background="{StaticResource PanelBackground}">
    <Grid x:Name="ContentGrid">
     <Grid.ColumnDefinitions><ColumnDefinition x:Name="SourceColumn" Width="0" /><ColumnDefinition x:Name="SplitDividerColumn" Width="0" /><ColumnDefinition x:Name="ReadColumn" Width="*" /></Grid.ColumnDefinitions>
     <controls:MonacoEditorView x:Name="SourceHost" Grid.Column="0" Visibility="Collapsed" />
     <GridSplitter x:Name="SplitDivider" Grid.Column="1" Width="6" Background="{StaticResource ShellBorder}" HorizontalAlignment="Center" Visibility="Collapsed" />
     <controls:MarkdownView x:Name="ReaderHost" Grid.Column="2" />
     <controls:DocumentMapView x:Name="MapHost" Grid.ColumnSpan="3" Visibility="Collapsed" />
     <Border x:Name="MessageOverlay" Grid.ColumnSpan="3" Background="{StaticResource PanelBackground}" Visibility="Collapsed" Padding="30">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
       <TextBlock x:Name="MessageTitle" Text="Choose your next page" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Center" />
       <TextBlock x:Name="MessageText" Text="Open a file, folder or documentation bundle." FontSize="14" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,16" TextAlignment="Center" />
       <Button x:Name="ChooseMissingButton" Content="Choose missing file" Style="{StaticResource ToolbarButton}" Click="ChooseMissing" Visibility="Collapsed" />
       <Button x:Name="ResumeWorkspaceButton" Content="Reopen last workspace" Style="{StaticResource ToolbarButton}" Click="ResumeWorkspace" Visibility="Collapsed" Margin="0,12" />
       <Button Content="Explore sample workspace" Style="{StaticResource ToolbarButton}" Click="OpenDemo" Margin="0,12" />
      </StackPanel>
     </Border>
    </Grid>
   </Border>
  </Grid>
  <Grid Grid.Row="3" Margin="20,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <TextBlock x:Name="StatusText" Text="Ready" FontSize="11" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Application status" />
   <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Click="CancelWork" Visibility="Collapsed" Padding="10,0" FontSize="11" />
  </Grid>
  <Border x:Name="SettingsPanel" Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Width="310" Margin="12,0,18,12" CornerRadius="12" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource ShellBorder}" BorderThickness="1" Visibility="Collapsed">
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
    <Grid><TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" /><Button x:Name="CloseSettingsButton" Content="×" HorizontalAlignment="Right" Style="{StaticResource ViewButton}" Click="ToggleSettings" AutomationProperties.Name="Close settings" /></Grid>
    <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}" />
    <ComboBox x:Name="AppearanceCombo" SelectionChanged="PreferenceChanged" Height="38" AutomationProperties.Name="Application appearance"><ComboBoxItem Content="System" /><ComboBoxItem Content="Light" /><ComboBoxItem Content="Dark" /></ComboBox>
    <TextBlock Text="DOCUMENT STYLE" Style="{StaticResource SectionLabel}" />
    <ComboBox x:Name="StyleCombo" SelectionChanged="PreferenceChanged" Height="38" AutomationProperties.Name="Document presentation"><ComboBoxItem Content="Technical documentation" /><ComboBoxItem Content="Editorial reading" /><ComboBoxItem Content="Compact reading" /></ComboBox>
    <CheckBox x:Name="SimpleSourceCheck" Content="Use lightweight source view" Margin="0,18" Checked="SourcePreferenceChanged" Unchecked="SourcePreferenceChanged" />
    <CheckBox x:Name="RememberDocumentCheck" Content="Remember last workspace" Margin="0,0,0,12" Checked="RememberPreferenceChanged" Unchecked="RememberPreferenceChanged" />
    <TextBlock Text="Document path and reading position stay on this device. Imported files and bundles must be selected again after restarting." Foreground="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />
    <Button x:Name="ResetSettingsButton" Content="Reset preferences" Style="{StaticResource ToolbarButton}" Click="ResetPreferences" Margin="0,4" />
    <TextBlock Text="EXPORT CURRENT PAGE" Style="{StaticResource SectionLabel}" />
    <Button x:Name="ExportHtmlButton" Content="Export HTML…" Style="{StaticResource ToolbarButton}" Click="ExportHtml" Margin="0,4" IsEnabled="False" />
    <Button x:Name="ExportPdfButton" Content="Export PDF…" Style="{StaticResource ToolbarButton}" Click="ExportPdf" Margin="0,4" IsEnabled="False" />
    <TextBlock x:Name="ExportHelp" Text="Images, diagrams and resolved ink are included on a light background. For PDF, choose Save as PDF in the print dialog." Foreground="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,12" />
    <TextBlock Text="WORKSPACE" Style="{StaticResource SectionLabel}" />
    <Button Content="Import folder" Style="{StaticResource ToolbarButton}" Click="ImportFolder" Margin="0,4" />
    <Button Content="Import documentation ZIP" Style="{StaticResource ToolbarButton}" Click="OpenZip" Margin="0,4" />
    <Button x:Name="RelatedFilesButton" Content="Add related files" Style="{StaticResource ToolbarButton}" Click="AddFiles" Margin="0,4" />
    <Button x:Name="RefreshButton" Content="Refresh folder" Style="{StaticResource ToolbarButton}" Click="RefreshWorkspace" Margin="0,4" />
    <Button Content="Reopen folder" Style="{StaticResource ToolbarButton}" Click="ReopenFolder" Margin="0,4" />
    <Button Content="Explore sample workspace" Style="{StaticResource ToolbarButton}" Click="OpenDemo" Margin="0,4" />
    <TextBlock x:Name="WorkspaceHelp" Text="Opened documents stay on this device. In the reader, choose Annotate to write notes for paragraphs. Save ink downloads a separate sidecar in the browser." Foreground="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,18,0,0" />
    <TextBlock Text="MARKVIBE" Style="{StaticResource SectionLabel}" />
    <Button Content="About MarkVibe" Style="{StaticResource ToolbarButton}" Click="ShowAbout" Margin="0,4" />
   </StackPanel></ScrollViewer>
  </Border>
 </Grid>
</UserControl>
