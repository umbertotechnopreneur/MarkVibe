<UserControl x:Class="MarkVibe.MainPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:MarkVibe.Controls"
 FontFamily="Segoe UI" Foreground="{StaticResource ShellText}">
 <Grid Background="{StaticResource AcrylicBackground}">
  <Grid.RowDefinitions>
   <RowDefinition Height="60" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
  </Grid.RowDefinitions>
  <Border Style="{StaticResource FocusHeader}">
   <Grid Margin="12,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="≡" Style="{StaticResource ToolbarButton}" Click="ToggleSidebar" AutomationProperties.Name="Toggle document sidebar" ToolTipService.ToolTip="Toggle sidebar" />
     <Border x:Name="BrandBadge" Background="{StaticResource Accent}" CornerRadius="10" Width="34" Height="34" Margin="10,0">
      <TextBlock Text="M" Foreground="White" FontWeight="Bold" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" />
     </Border>
     <Button x:Name="BackButton" Content="←" Style="{StaticResource ToolbarButton}" Click="Back" IsEnabled="False" AutomationProperties.Name="Back" ToolTipService.ToolTip="Back · Alt+Left" />
     <Button x:Name="ForwardButton" Content="→" Style="{StaticResource ToolbarButton}" Click="Forward" IsEnabled="False" AutomationProperties.Name="Forward" ToolTipService.ToolTip="Forward · Alt+Right" />
    </StackPanel>
    <Grid x:Name="TitlePanel" Grid.ColumnSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="290,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <HyperlinkButton x:Name="HeaderParentFolderButton" Content="../" Style="{StaticResource AppLink}"
                      Click="OpenParentFolder" Visibility="Collapsed" IsEnabled="False"
                      FontFamily="Consolas" FontSize="17" FontWeight="Light" Margin="0,0,4,0" Padding="0"
                      VerticalAlignment="Center" controls:IconLabel.HideIcon="True"
                      AutomationProperties.Name="Go up one folder" ToolTipService.ToolTip="Go up one folder" />
     <TextBlock x:Name="DocumentTitle" Grid.Column="1" Text="MarkVibe" FontFamily="Consolas" FontSize="17" FontWeight="Light" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
    </Grid>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="OpenFileButton" Content="Open file" Style="{StaticResource ToolbarButton}" Click="OpenFiles" AutomationProperties.Name="Open Markdown files and related resources" />
     <Button x:Name="OpenFolderButton" Content="Open folder" Style="{StaticResource ToolbarButton}" Click="OpenFolder" />
     <Button x:Name="SettingsButton" Content="Settings" Style="{StaticResource ToolbarButton}" Click="ToggleSettings" AutomationProperties.Name="Appearance and settings" ToolTipService.ToolTip="Appearance and settings" />
     <Button x:Name="AboutButton" Content="ⓘ" Style="{StaticResource ToolbarButton}" Click="ShowAbout" AutomationProperties.Name="About MarkVibe" ToolTipService.ToolTip="About MarkVibe" />
     <HyperlinkButton Style="{StaticResource AppLink}" Click="OpenManifesto" AutomationProperties.Name="Participates in VibeWare. Read the manifesto" ToolTipService.ToolTip="Participates in VibeWare. Read the manifesto" Margin="8,0,0,0" Padding="2" controls:IconLabel.HideIcon="True">
      <Image x:Name="VibeWareHeaderLogo" Width="34" Height="34" Stretch="Uniform" IsHitTestVisible="False" />
     </HyperlinkButton>
    </StackPanel>
   </Grid>
  </Border>
  <Grid x:Name="WorkspaceGrid" Grid.Row="1">
   <Grid.ColumnDefinitions>
    <ColumnDefinition x:Name="SidebarColumn" Width="220" />
    <ColumnDefinition x:Name="SidebarDividerColumn" Width="6" />
    <ColumnDefinition x:Name="DocumentColumn" Width="*" />
    <ColumnDefinition x:Name="AiDividerColumn" Width="0" />
    <ColumnDefinition x:Name="AiColumn" Width="0" />
   </Grid.ColumnDefinitions>
   <Border x:Name="Sidebar" Style="{StaticResource FocusSidebar}">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
     <Grid Margin="20,22,20,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <HyperlinkButton x:Name="SidebarParentFolderButton" Content="../" Style="{StaticResource AppLink}"
                       Click="OpenParentFolder" Visibility="Collapsed" IsEnabled="False"
                       FontSize="14" Margin="0,0,4,0" Padding="0" VerticalAlignment="Center"
                       controls:IconLabel.HideIcon="True" AutomationProperties.Name="Go up one folder"
                       ToolTipService.ToolTip="Go up one folder" />
      <TextBlock x:Name="WorkspaceName" Grid.Column="1" Text="Sample workspace" FontSize="14" TextTrimming="CharacterEllipsis" />
     </Grid>
     <TabControl x:Name="SidebarTabsControl" Grid.Row="1" Style="{StaticResource SidebarTabs}" SelectedIndex="0" AutomationProperties.Name="Document navigation">
      <TabItem x:Name="PagesTab" Header="Pages" Style="{StaticResource SidebarTab}" ToolTipService.ToolTip="Browse workspace pages">
       <TreeView x:Name="DocumentTree" Background="Transparent" BorderThickness="0" Padding="0"
        SelectedItemChanged="DocumentSelected" Margin="6,0,6,8"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Workspace documents" />
      </TabItem>
      <TabItem x:Name="OutlineTab" Header="Outline" Style="{StaticResource SidebarTab}" ToolTipService.ToolTip="Browse headings in the current document">
       <TreeView x:Name="OutlineTree" Background="Transparent" BorderThickness="0" Padding="0" Margin="6,0,6,8"
        SelectedItemChanged="OutlineSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Current document outline" />
      </TabItem>
     </TabControl>
    </Grid>
   </Border>
   <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="{StaticResource ShellBorder}" AutomationProperties.Name="Resize document sidebar" />
   <Border x:Name="DocumentPanel" Grid.Column="2" Background="Transparent">
    <Grid>
     <Grid.RowDefinitions><RowDefinition x:Name="DocumentToolbarRow" Height="56" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
     <Grid x:Name="DocumentToolbar" Margin="12,0">
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="ReadButton" Content="Read" Style="{StaticResource FocusViewButton}" Click="ReadView" ToolTipService.ToolTip="Read the formatted document" />
        <Button x:Name="SourceButton" Content="Source" Style="{StaticResource FocusViewButton}" Click="SourceViewClick" ToolTipService.ToolTip="View Markdown source" />
        <Button x:Name="SplitButton" Content="Split" Style="{StaticResource FocusViewButton}" Click="SplitView" ToolTipService.ToolTip="Show document and source side by side" />
        <Button x:Name="MapButton" Content="Map" Style="{StaticResource FocusViewButton}" Click="MapViewClick" ToolTipService.ToolTip="Explore document connections" />
        <Button x:Name="AiButton" Content="AI" Style="{StaticResource FocusViewButton}" Click="ToggleMarkdownAi" AutomationProperties.Name="Markdown AI assistant" ToolTipService.ToolTip="Edit the document or selection with AI" />
       </StackPanel>
      </ScrollViewer>
      <StackPanel x:Name="DocumentActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
       <StackPanel x:Name="ReaderWidthControls" Orientation="Horizontal" Margin="0,0,12,0">
        <Button x:Name="ColumnButton" Content="Column" Style="{StaticResource FocusViewButton}" Click="ChangeReaderWidth" AutomationProperties.Name="Column" ToolTipService.ToolTip="Read in a centered column" />
        <Button x:Name="ExpandedColumnButton" Content="Expanded column" Style="{StaticResource FocusViewButton}" Click="ChangeReaderWidth" AutomationProperties.Name="Expanded column" ToolTipService.ToolTip="Use the full available reading width" />
       </StackPanel>
       <Button x:Name="ExportHtmlButton" Content="Export HTML…" Style="{StaticResource ToolbarButton}" Click="ExportHtml" ToolTipService.ToolTip="Export the current document as HTML" />
       <Button x:Name="ExportPdfButton" Content="Export PDF…" Style="{StaticResource ToolbarButton}" Click="ExportPdf" ToolTipService.ToolTip="Save the current document as PDF" />
      </StackPanel>
     </Grid>
    <controls:DocumentFindView x:Name="DocumentFind" Grid.Row="1" Visibility="Collapsed" />
    <Grid x:Name="DocumentViewport" Grid.Row="2" Background="Transparent">
    <Grid x:Name="ContentGrid" Background="Transparent">
     <Grid.ColumnDefinitions><ColumnDefinition x:Name="SourceColumn" Width="0" /><ColumnDefinition x:Name="SplitDividerColumn" Width="0" /><ColumnDefinition x:Name="ReadColumn" Width="*" /></Grid.ColumnDefinitions>
     <controls:MonacoEditorView x:Name="SourceHost" Grid.Column="0" Visibility="Collapsed" />
     <GridSplitter x:Name="SplitDivider" Grid.Column="1" Width="6" Background="{StaticResource ShellBorder}" HorizontalAlignment="Center" Visibility="Collapsed" />
     <controls:MarkdownView x:Name="ReaderHost" Grid.Column="2" />
     <controls:DocumentMapView x:Name="MapHost" Grid.ColumnSpan="3" Visibility="Collapsed" />
     <Border x:Name="MessageOverlay" Grid.ColumnSpan="3" Background="{StaticResource PanelBackground}" Visibility="Collapsed" Padding="30">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
       <TextBlock x:Name="MessageTitle" Text="Choose your next page" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Center" />
       <TextBlock x:Name="MessageText" Text="Open a file, folder or documentation bundle." FontSize="14" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,16" TextAlignment="Center" />
       <Button x:Name="ChooseMissingButton" Content="Choose missing file" Style="{StaticResource ToolbarButton}" Click="ChooseMissing" Visibility="Collapsed" />
       <Button x:Name="ResumeWorkspaceButton" Content="Reopen last workspace" Style="{StaticResource ToolbarButton}" Click="ResumeWorkspace" Visibility="Collapsed" Margin="0,12" />
       <Button Content="Explore sample workspace" Style="{StaticResource ToolbarButton}" Click="OpenDemo" Margin="0,12" />
      </StackPanel>
     </Border>
    </Grid>
     <controls:MarkdownAiWaitView x:Name="AiWaitHost" Visibility="Collapsed" />
    </Grid>
    </Grid>
   </Border>
   <GridSplitter x:Name="AiSplitter" Grid.Column="3" Width="6" HorizontalAlignment="Center" Background="{StaticResource ShellBorder}" Visibility="Collapsed" AutomationProperties.Name="Resize AI assistant" />
   <controls:MarkdownAiView x:Name="AiHost" Grid.Column="4" Visibility="Collapsed" />
  </Grid>
  <controls:AppFooter x:Name="PublicationFooter" Grid.Row="2" />
  <Border x:Name="StatusNotice" Grid.Row="1" Margin="20" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Right" MaxWidth="520" Padding="12" CornerRadius="8" Background="{StaticResource PanelBackground}">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource ShellText}" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.Name="Application status" />
   <Button x:Name="MissingResourceButton" Grid.Column="1" Content="Choose missing image" Click="ChooseMissingResource" Visibility="Collapsed" ToolTipService.ToolTip="Choose missing image" FontSize="11" />
   <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Click="CancelWork" Visibility="Collapsed" Padding="10,0" FontSize="11" />
   <Button Grid.Column="2" Content="×" controls:IconLabel.HideIcon="True" ToolTipService.ToolTip="Close" AutomationProperties.Name="Close" Click="DismissStatus" FontSize="18" Margin="8,0,0,0" />
  </Grid>
  </Border>
  <Popup x:Name="RecentLocationsPopup">
   <Border x:Name="RecentLocationsSurface" Width="480" Style="{StaticResource FlyoutSurface}" Padding="10" KeyDown="RecentLocationsKeyDown">
    <StackPanel>
     <Button x:Name="BrowseRecentLocationButton" Style="{StaticResource FileMenuButton}" Click="BrowseRecentLocation" />
     <Border Height="1" Margin="0,6" Background="{StaticResource ShellBorder}" />
     <TextBlock x:Name="RecentLocationsTitle" Margin="10,6,10,10" FontWeight="SemiBold" />
     <ScrollViewer x:Name="RecentLocationsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="RecentLocationItems" />
     </ScrollViewer>
    </StackPanel>
   </Border>
  </Popup>
  <Popup x:Name="FileMenuPopup">
   <Border x:Name="FileMenuSurface" Width="310" Style="{StaticResource FlyoutSurface}" Padding="10" KeyDown="FileMenuKeyDown">
    <ScrollViewer x:Name="FileMenuScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <TextBlock x:Name="FileMenuTitle" Margin="10,8,10,0" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     <TextBlock x:Name="FileMenuPath" Margin="10,5,10,12" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
     <Border Height="1" Margin="0,0,0,6" Background="{StaticResource ShellBorder}"/>
     <controls:FileActionsView x:Name="DocumentFileActions"/>
     <Expander x:Name="ReaderAppearanceGroup" Header="Appearance" Style="{StaticResource MinimalExpander}" IsExpanded="False">
      <controls:ReaderAppearanceView x:Name="DocumentAppearance"/>
     </Expander>
    </StackPanel>
    </ScrollViewer>
   </Border>
  </Popup>
 </Grid>
</UserControl>
