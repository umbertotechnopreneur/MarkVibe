<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsOpenSilver>true</IsOpenSilver>
    <EnableDefaultItems>false</EnableDefaultItems>
    <OpenSilverEnableDefaultResourceEmbedding>false</OpenSilverEnableDefaultResourceEmbedding>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenSilver" Version="[3.3.3]" />
    <PackageReference Include="OpenSilver.Themes.Modern" Version="[3.3.0]" />
    <!-- Patch the vulnerable XML dependency brought in by System.ServiceModel.Primitives. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="[8.0.4]" />
    <ProjectReference Include="../MarkVibe.Core/MarkVibe.Core.csproj" />
    <Compile Include="**/*.cs" Exclude="bin/**;obj/**" />
    <ApplicationDefinition Include="App.xaml"><Generator>MSBuild:Compile</Generator></ApplicationDefinition>
    <Page Include="MainPage.xaml"><Generator>MSBuild:Compile</Generator></Page>
    <Page Include="AboutWindow.xaml"><Generator>MSBuild:Compile</Generator></Page>
    <Page Include="SettingsWindow.xaml"><Generator>MSBuild:Compile</Generator></Page>
    <Page Include="Controls/*.xaml"><Generator>MSBuild:Compile</Generator></Page>
    <Page Include="Styles/*.xaml"><Generator>MSBuild:Compile</Generator></Page>
  </ItemGroup>
</Project>
