<Application x:Class="MarkVibe.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:modern="http://opensilver.net/themes/modern">
 <Application.Theme>
  <modern:ModernTheme CurrentPalette="Light">
   <modern:ModernTheme.LightPalette>
    <modern:LightPalette BackgroundColor="#F4F5F7" ContainerBackgroundColor="#FFFFFF" ControlBackgroundColor="#FFFFFF" TextColor="#20283A" WatermarkColor="#596579" BorderColor="#DDE2EA" PrimaryColor="#525CE8" AlternateRowColor="#ECEEFE" />
   </modern:ModernTheme.LightPalette>
   <modern:ModernTheme.DarkPalette>
    <modern:DarkPalette BackgroundColor="#111621" ContainerBackgroundColor="#181F2D" ControlBackgroundColor="#181F2D" TextColor="#E5EAF4" WatermarkColor="#A4B0C4" BorderColor="#303C52" PrimaryColor="#929AFF" AlternateRowColor="#2A3155" TextOnPrimaryColor="#111621" />
   </modern:ModernTheme.DarkPalette>
  </modern:ModernTheme>
 </Application.Theme>
 <Application.Resources>
  <SolidColorBrush x:Key="ShellBackground" Color="#F4F5F7" />
  <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ShellText" Color="#20283A" />
  <SolidColorBrush x:Key="MutedText" Color="#596579" />
  <SolidColorBrush x:Key="ShellBorder" Color="#DDE2EA" />
  <SolidColorBrush x:Key="Accent" Color="#525CE8" />
  <SolidColorBrush x:Key="AccentSoft" Color="#ECEEFE" />
  <Style x:Key="ToolbarButton" TargetType="Button">
   <Setter Property="FontSize" Value="13" />
   <Setter Property="Foreground" Value="{StaticResource ShellText}" />
   <Setter Property="Background" Value="{StaticResource PanelBackground}" />
   <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}" />
   <Setter Property="BorderThickness" Value="1" />
   <Setter Property="Padding" Value="12,8" />
   <Setter Property="MinHeight" Value="40" />
   <Setter Property="MinWidth" Value="40" />
   <Setter Property="Margin" Value="3,0" />
  </Style>
  <Style x:Key="ViewButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
   <Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="{StaticResource ShellBackground}" />
  </Style>
  <Style x:Key="SectionLabel" TargetType="TextBlock">
   <Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" />
   <Setter Property="Foreground" Value="{StaticResource MutedText}" /><Setter Property="Margin" Value="18,16,18,8" />
  </Style>
 </Application.Resources>
</Application>
