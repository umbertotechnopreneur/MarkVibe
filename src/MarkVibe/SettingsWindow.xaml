<ChildWindow x:Class="MarkVibe.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:MarkVibe.Controls"
 Title="Settings" Width="1000" Height="700" Style="{StaticResource AppDialog}">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid x:Name="SettingsColumns" Margin="28,4,28,24">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel x:Name="PreferencesColumn">
     <TextBlock Text="Make MarkVibe yours" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,4" />
     <TextBlock Text="Changes are saved automatically." Foreground="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" />
     <TextBlock Text="APPEARANCE" Style="{StaticResource DialogSectionLabel}" />
     <ComboBox x:Name="AppearanceCombo" SelectionChanged="PreferenceChanged" Height="38" AutomationProperties.Name="Application appearance" ToolTipService.ToolTip="Follow the system theme or choose light or dark"><ComboBoxItem Content="System" /><ComboBoxItem Content="Light" /><ComboBoxItem Content="Dark" /></ComboBox>
     <CheckBox x:Name="AcrylicCheck" Content="Acrylic window background" Margin="0,14,0,0" Checked="CheckChanged" Unchecked="CheckChanged" ToolTipService.ToolTip="Use Acrylic outside the document on supported Windows systems" />
     <TextBlock x:Name="AcrylicHelp" Foreground="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
     <TextBlock Text="LANGUAGE" Style="{StaticResource DialogSectionLabel}" />
     <ComboBox x:Name="LanguageCombo" SelectionChanged="PreferenceChanged" Height="38" AutomationProperties.Name="Application language" ToolTipService.ToolTip="Follow the system language or choose another language">
      <ComboBoxItem Content="System language" /><ComboBoxItem Content="English" /><ComboBoxItem Content="Italiano" /><ComboBoxItem Content="Français" /><ComboBoxItem Content="Tiếng Việt" /><ComboBoxItem Content="简体中文" /><ComboBoxItem Content="廣東話" /><ComboBoxItem Content="Bahasa Indonesia" /><ComboBoxItem Content="한국어" /><ComboBoxItem Content="日本語" />
     </ComboBox>
     <TextBlock Text="UI FONT" Style="{StaticResource DialogSectionLabel}" />
     <ComboBox x:Name="UiFontCombo" SelectionChanged="PreferenceChanged" Height="38" IsEnabled="False" AutomationProperties.Name="UI font" ToolTipService.ToolTip="Choose the font for menus, toolbars and dialogs">
      <ComboBoxItem Content="System default" Tag="system" />
     </ComboBox>
     <TextBlock Text="Only installed fonts are shown. Document typography stays separate." Foreground="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
     <CheckBox x:Name="SimpleSourceCheck" Content="Use lightweight source view" Margin="0,18,0,12" Checked="CheckChanged" Unchecked="CheckChanged" ToolTipService.ToolTip="Use a simple source view instead of Monaco" />
     <CheckBox x:Name="RememberDocumentCheck" Content="Remember last workspace" Margin="0,0,0,10" Checked="CheckChanged" Unchecked="CheckChanged" ToolTipService.ToolTip="Reopen the last document at its saved reading position" />
     <TextBlock Text="Document path and reading position stay on this device. Imported files and bundles must be selected again after restarting." Foreground="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
     <Button Content="Reset preferences" Style="{StaticResource ToolbarButton}" Click="ResetPreferences" ToolTipService.ToolTip="Restore the default appearance, language and reading preferences" HorizontalAlignment="Left" Margin="0,12,0,0" />
    </StackPanel>
    <StackPanel x:Name="ActionsColumn" Grid.Column="2">
     <TextBlock Text="DOCUMENT STYLE" Style="{StaticResource DialogSectionLabel}" />
     <ComboBox x:Name="StyleCombo" SelectionChanged="PreferenceChanged" Height="38" AutomationProperties.Name="Document presentation" ToolTipService.ToolTip="Choose the document reading style"><ComboBoxItem Content="Technical documentation" /><ComboBoxItem Content="Editorial reading" /><ComboBoxItem Content="Compact reading" /></ComboBox>
     <TextBlock Text="LIGHT DOCUMENT THEME" Style="{StaticResource DialogSectionLabel}" />
     <ComboBox x:Name="LightDocumentThemeCombo" Height="38" SelectionChanged="PreferenceChanged" ToolTipService.ToolTip="Choose document colors and fonts for light mode" />
     <TextBlock Text="DARK DOCUMENT THEME" Style="{StaticResource DialogSectionLabel}" />
     <ComboBox x:Name="DarkDocumentThemeCombo" Height="38" SelectionChanged="PreferenceChanged" ToolTipService.ToolTip="Choose document colors and fonts for dark mode" />
     <TextBlock Text="Themes include their own typography. Fonts use what is installed on this device." Foreground="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
     <TextBlock Text="LIGHT CODE THEME" Style="{StaticResource DialogSectionLabel}" />
     <ComboBox x:Name="LightCodeThemeCombo" Height="38" SelectionChanged="PreferenceChanged" ToolTipService.ToolTip="Choose code block colors for light mode" />
     <TextBlock Text="DARK CODE THEME" Style="{StaticResource DialogSectionLabel}" />
     <ComboBox x:Name="DarkCodeThemeCombo" Height="38" SelectionChanged="PreferenceChanged" ToolTipService.ToolTip="Choose code block colors for dark mode" />
    </StackPanel>
    <StackPanel x:Name="OpenAiColumn" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,24,0,0">
      <Border Height="1" Background="{StaticResource ShellBorder}" Margin="0,0,0,20" />
      <Grid Margin="0,0,0,14">
       <StackPanel Orientation="Horizontal">
        <Image x:Name="OpenAiLogo" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" />
        <TextBlock Text="OpenAI" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
       </StackPanel>
      </Grid>
      <Grid x:Name="CodexProviderRow" Margin="0,0,0,14">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <RadioButton x:Name="CodexProviderRadio" GroupName="AiProvider" Content="Codex CLI" Tag="codex-cli" Checked="ProviderChanged" VerticalAlignment="Center" Foreground="{StaticResource ShellText}" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource ShellBorder}"/>
       <Button x:Name="CodexInfoButton" Grid.Column="1" Style="{StaticResource CompactIconButton}" Foreground="#3688D8" Click="ShowConnectionInformation" LostFocus="HideConnectionInformation" AutomationProperties.Name="Codex CLI connection information" Margin="6,0">
        <controls:VectorIcon Symbol="about" Foreground="#3688D8" Width="16" Height="16"/>
       </Button>
       <Button x:Name="TestCodexButton" Grid.Column="2" Content="Test" Style="{StaticResource DialogPrimaryButton}" Click="TestCodexConnection" IsEnabled="False" MinWidth="92" Padding="12,7" FontSize="12" ToolTipService.ToolTip="Test the Codex CLI connection" AutomationProperties.Name="Test the Codex CLI connection"/>
       <TextBlock x:Name="CodexConnectionStatus" Grid.Row="1" Grid.ColumnSpan="3" Text="Checking status…" Foreground="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
      </Grid>
      <Grid x:Name="ApiProviderRow">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <RadioButton x:Name="ApiProviderRadio" GroupName="AiProvider" Content="OpenAI API key" Tag="api-key" Checked="ProviderChanged" VerticalAlignment="Center" Foreground="{StaticResource ShellText}" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource ShellBorder}"/>
       <Button x:Name="ApiInfoButton" Grid.Column="1" Style="{StaticResource CompactIconButton}" Foreground="#3688D8" Click="ShowConnectionInformation" LostFocus="HideConnectionInformation" AutomationProperties.Name="OpenAI API connection information" Margin="6,0">
        <controls:VectorIcon Symbol="about" Foreground="#3688D8" Width="16" Height="16"/>
       </Button>
       <Button x:Name="TestApiButton" Grid.Column="2" Content="Test" Style="{StaticResource DialogPrimaryButton}" Click="TestApiConnection" IsEnabled="False" MinWidth="92" Padding="12,7" FontSize="12" ToolTipService.ToolTip="Test the OpenAI API connection" AutomationProperties.Name="Test the OpenAI API connection"/>
       <TextBlock x:Name="ApiConnectionStatus" Grid.Row="1" Grid.ColumnSpan="3" Text="Checking status…" Foreground="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
      </Grid>
      <Grid x:Name="OpenAiKeyForm">
       <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
       <TextBlock x:Name="OpenAiKeyLabel" Text="API key" FontSize="12" Foreground="{StaticResource MutedText}" Margin="0,12,0,8" />
       <PasswordBox x:Name="OpenAiApiKeyBox" Grid.Row="1" Height="38" MaxLength="4096" IsEnabled="False" PasswordChanged="OpenAiKeyChanged" AutomationProperties.Name="OpenAI API key" ToolTipService.ToolTip="Paste your OpenAI API key"/>
       <TextBlock x:Name="OpenAiKeyHint" Grid.Row="2" Text="Paste a key to connect AI writing tools." Foreground="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
      </Grid>
      <Border x:Name="OpenAiFeedback" Visibility="Collapsed" Margin="0,10,0,0">
       <TextBlock x:Name="OpenAiStatus" Foreground="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" />
      </Border>
    </StackPanel>
   </Grid>
  </ScrollViewer>
  <Border Grid.Row="1" Padding="28,14,28,18" BorderThickness="0,1,0,0" BorderBrush="{StaticResource ShellBorder}">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <TextBlock x:Name="SettingsStatus" FontSize="12" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0" />
    <Button Grid.Column="1" Content="Close" Style="{StaticResource DialogPrimaryButton}" Click="Dismiss" ToolTipService.ToolTip="Close settings" controls:IconLabel.HideIcon="True" />
   </Grid>
  </Border>
 </Grid>
</ChildWindow>
