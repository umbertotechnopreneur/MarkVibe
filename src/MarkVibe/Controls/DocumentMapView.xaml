<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:MarkVibe.Controls" x:Class="MarkVibe.Controls.DocumentMapView">
    <UserControl.Resources>
        <SolidColorBrush x:Key="MapChromeText" Color="#DDE4EF"/>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#10141B"/>
            <Setter Property="Foreground" Value="{StaticResource MapChromeText}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="MapToolbarButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Foreground" Value="{StaticResource MapChromeText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="MapIconButton" TargetType="Button" BasedOn="{StaticResource CompactIconButton}">
            <Setter Property="Foreground" Value="{StaticResource MapChromeText}"/>
        </Style>
        <Style x:Key="MapLinkButton" TargetType="Button" BasedOn="{StaticResource FileMenuButton}">
            <Setter Property="Foreground" Value="{StaticResource MapChromeText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="9,10"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="Black">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="LinksColumn" Width="200"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <controls:MapRenderer x:Name="Renderer" Grid.RowSpan="5"/>
        <Border Background="#F00B0D11" BorderBrush="#354052" BorderThickness="1" CornerRadius="14" Padding="6" Margin="16,16,16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Summary" Grid.Column="2" Margin="12,0,6,0" FontSize="11" VerticalAlignment="Center" Foreground="#8590A3"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" BorderThickness="0" Padding="0">
                <StackPanel Orientation="Horizontal">
                <StackPanel x:Name="LayoutButtons" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,8,0">
                    <Button x:Name="StarButton" Content="Star" Style="{StaticResource MapToolbarButton}" Click="ArrangeStar" ToolTipService.ToolTip="Arrange around the most connected page" AutomationProperties.Name="Arrange around the most connected page"/>
                    <Button x:Name="CircleButton" Content="Circle" Style="{StaticResource MapToolbarButton}" Click="ArrangeCircle" ToolTipService.ToolTip="Arrange in a circle" AutomationProperties.Name="Arrange in a circle"/>
                    <Button x:Name="GridButton" Content="Grid" Style="{StaticResource MapToolbarButton}" Click="ArrangeGrid" ToolTipService.ToolTip="Arrange in a grid" AutomationProperties.Name="Arrange in a grid"/>
                    <Button x:Name="TreeButton" Style="{StaticResource MapToolbarButton}" Click="ArrangeTree" ToolTipService.ToolTip="Arrange as a tree" AutomationProperties.Name="Arrange as a tree"/>
                    <Button x:Name="FoldersButton" Style="{StaticResource MapToolbarButton}" Click="ArrangeFolders" ToolTipService.ToolTip="Group by folder" AutomationProperties.Name="Group by folder"/>
                    <Border Width="1" Height="20" Margin="6,0" Background="#252B35"/>
                    <Button x:Name="AdvancedButton" Content="Advanced view" Style="{StaticResource MapToolbarButton}" Click="ToggleAdvanced" ToolTipService.ToolTip="Show file size, estimated tokens, characters and words" AutomationProperties.Name="Advanced view"/>
                    <Button x:Name="DepthButton" Style="{StaticResource MapToolbarButton}" Click="ToggleDepth" ToolTipService.ToolTip="Show connection depth" AutomationProperties.Name="Show connection depth"/>
                </StackPanel>
                <StackPanel x:Name="MapActions" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Button x:Name="FocusButton" Style="{StaticResource MapIconButton}" Click="FocusMap" ToolTipService.ToolTip="Focus on this page" AutomationProperties.Name="Focus on this page">
                        <controls:VectorIcon Symbol="focus"/>
                    </Button>
                    <Button x:Name="InspectorButton" Style="{StaticResource MapIconButton}" Click="ToggleInspector" ToolTipService.ToolTip="Document preview" AutomationProperties.Name="Document preview">
                        <controls:VectorIcon Symbol="book"/>
                    </Button>
                    <Button Style="{StaticResource MapIconButton}" Click="FitMap" ToolTipService.ToolTip="Fit document map" AutomationProperties.Name="Fit document map">
                        <controls:VectorIcon Symbol="fit"/>
                    </Button>
                    <Button x:Name="SaveButton" Style="{StaticResource MapIconButton}" Click="SaveMap" ToolTipService.ToolTip="Save layout" AutomationProperties.Name="Save layout">
                        <controls:VectorIcon Symbol="save"/>
                    </Button>
                    <Button x:Name="DownloadButton" Style="{StaticResource MapIconButton}" Click="DownloadMap" ToolTipService.ToolTip="Download layout" AutomationProperties.Name="Download layout">
                        <controls:VectorIcon Symbol="download"/>
                    </Button>
                    <Button x:Name="DiscardButton" Style="{StaticResource MapIconButton}" Click="DiscardMap" ToolTipService.ToolTip="Discard changes" AutomationProperties.Name="Discard changes">
                        <controls:VectorIcon Symbol="close"/>
                    </Button>
                    <Button x:Name="ResetButton" Style="{StaticResource MapIconButton}" Click="ResetMap" ToolTipService.ToolTip="Reset all" AutomationProperties.Name="Reset all">
                        <controls:VectorIcon Symbol="reset"/>
                    </Button>
                    <Button x:Name="AddToAiButton" Style="{StaticResource MapIconButton}" Click="ToggleAiContext" ToolTipService.ToolTip="Add selected document to AI context" AutomationProperties.Name="Add selected document to AI context">
                        <controls:VectorIcon Symbol="sparkles"/>
                    </Button>
                </StackPanel>
                </StackPanel>
                </ScrollViewer>
                <Border x:Name="SearchField" Grid.Column="1" Width="250" Height="34" Margin="10,0,0,0" VerticalAlignment="Center" Background="#10141B" BorderBrush="#303846" BorderThickness="1" CornerRadius="7">
                    <Grid>
                        <TextBox x:Name="MapSearchBox" Background="Transparent" Foreground="{StaticResource MapChromeText}" BorderThickness="0" Padding="30,6,30,6" FontSize="12" VerticalContentAlignment="Center" TextChanged="MapSearchChanged" KeyDown="MapSearchKeyDown" ToolTipService.ToolTip="Find a document" AutomationProperties.Name="Find a document"/>
                        <controls:VectorIcon Symbol="search" Width="16" Height="16" Foreground="#8590A3" Margin="9,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock x:Name="MapSearchWatermark" Text="Type to search…" Margin="30,0,28,0" FontSize="12" Foreground="#8590A3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
                        <Button x:Name="ClearSearchButton" Style="{StaticResource MapIconButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" Click="ClearMapSearch" ToolTipService.ToolTip="Clear search" AutomationProperties.Name="Clear search">
                            <controls:VectorIcon Symbol="close" Width="14" Height="14"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="#F00B0D11" BorderBrush="#303846" BorderThickness="1" CornerRadius="12" Margin="16,0,16,6" Padding="6">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" BorderThickness="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Neighborhood" Foreground="#A7B2C4" FontSize="11" VerticalAlignment="Center" Margin="6,0,8,0"/>
                    <ComboBox x:Name="NeighborhoodDepth" Width="120" MinHeight="30" Background="#10141B" Foreground="{StaticResource MapChromeText}" SelectionChanged="NeighborhoodChanged" AutomationProperties.Name="Neighborhood">
                        <ComboBoxItem Content="All documents"/>
                        <ComboBoxItem Content="1 link away"/>
                        <ComboBoxItem Content="2 links away"/>
                        <ComboBoxItem Content="3 links away"/>
                    </ComboBox>
                    <Border Width="1" Height="20" Background="#303846" Margin="12,0"/>
                    <Grid Width="130" MinHeight="30">
                        <TextBox x:Name="ViewName" MinHeight="30" MaxLength="64" Background="#10141B" Foreground="{StaticResource MapChromeText}" BorderBrush="#303846" VerticalContentAlignment="Center" KeyDown="ViewNameKeyDown" TextChanged="ViewNameChanged" AutomationProperties.Name="View name" ToolTipService.ToolTip="View name"/>
                        <TextBlock x:Name="ViewNameWatermark" Text="View name" Margin="8,0" FontSize="11" Foreground="#8590A3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
                    </Grid>
                    <Button x:Name="SaveViewButton" Content="Save view" Style="{StaticResource MapToolbarButton}" Click="SaveView" Margin="4,0,10,0"/>
                    <ComboBox x:Name="SavedViews" Width="155" MinHeight="30" Background="#10141B" Foreground="{StaticResource MapChromeText}" AutomationProperties.Name="Saved views" SelectionChanged="SavedViewChanged"/>
                    <Button x:Name="RestoreViewButton" Content="Restore view" Style="{StaticResource MapToolbarButton}" Click="RestoreView" Margin="4,0,0,0"/>
                    <Button x:Name="DeleteViewButton" Style="{StaticResource MapIconButton}" Click="DeleteView" ToolTipService.ToolTip="Delete saved view" AutomationProperties.Name="Delete saved view">
                        <controls:VectorIcon Symbol="close"/>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border x:Name="SearchFeedback" Grid.Row="2" Background="#10141B" BorderBrush="#303846" BorderThickness="1" CornerRadius="8" Margin="16,0,16,8" Padding="6" Visibility="Collapsed" MaxWidth="440" HorizontalAlignment="Right">
            <StackPanel>
                <ListBox x:Name="MapSearchResults" MaxHeight="180" Background="Transparent" Foreground="{StaticResource MapChromeText}" BorderThickness="0" Visibility="Collapsed" SelectionChanged="MapSearchSelected" AutomationProperties.Name="Find a document"/>
                <TextBlock x:Name="MapSearchEmpty" Text="No matching documents" Margin="8" Foreground="#A7B2C4" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
        <Border x:Name="MapNotice" Grid.Row="3" Background="{StaticResource AccentSoft}" Padding="16,10" Visibility="Collapsed">
            <TextBlock x:Name="MapNoticeText" TextWrapping="Wrap" Foreground="{StaticResource MapChromeText}"/>
        </Border>
        <ScrollViewer x:Name="LinksPane" Grid.Column="1" Grid.RowSpan="5" Background="#F8080A0E" Foreground="{StaticResource MapChromeText}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18">
            <StackPanel x:Name="Links"/>
        </ScrollViewer>
        <Popup x:Name="AppearancePopup">
            <Border x:Name="MapFlyoutSurface" Width="340" Style="{StaticResource FlyoutSurface}" Padding="16" KeyDown="AppearanceKeyDown">
                <ScrollViewer x:Name="AppearanceScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="650">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Customize card" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                        <Button Grid.Column="1" Style="{StaticResource CompactIconButton}" Click="CloseAppearance" AutomationProperties.Name="Close">
                            <controls:VectorIcon Symbol="close"/>
                        </Button>
                    </Grid>
                    <Border x:Name="AppearancePreview" Background="#080B10" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,12,0,16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <controls:VectorIcon x:Name="AppearanceIcon" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="AppearanceTitle" Grid.Column="1" Foreground="#EEF3FC" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="AppearancePath" Foreground="#8F9EB3" FontFamily="Consolas" FontSize="10" Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Card color" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ColorCaption" Grid.Column="1" FontSize="11" Foreground="{StaticResource MutedText}"/>
                    </Grid>
                    <Grid x:Name="Colors" Margin="0,6,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Card icon" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="IconCaption" Grid.Column="1" FontSize="11" Foreground="{StaticResource MutedText}"/>
                    </Grid>
                    <Grid x:Name="Icons" Margin="0,6,0,10"/>
                    <TextBlock Text="Changes apply immediately" Foreground="{StaticResource MutedText}" FontSize="10" Margin="2,0,0,8"/>
                    <Border x:Name="AppearanceFileDivider" Height="1" Margin="0,4,0,6" Background="{StaticResource ShellBorder}"/>
                    <controls:FileActionsView x:Name="AppearanceFileActions"/>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
