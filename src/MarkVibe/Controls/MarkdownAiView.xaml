<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:MarkVibe.Controls" x:Class="MarkVibe.Controls.MarkdownAiView" Foreground="{StaticResource ShellText}">
    <Border x:Name="AiSurface" Style="{StaticResource FlyoutSurface}">
        <Grid Margin="14,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid x:Name="TitleBar" Background="Transparent" Cursor="Hand" ToolTipService.ToolTip="Drag AI Assistant" MouseLeftButtonDown="BeginPanelDrag" MouseMove="MovePanel" MouseLeftButtonUp="EndPanelDrag" LostMouseCapture="CancelPanelDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Heading" Text="AI Assistant" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                <Button Grid.Column="1" x:Name="CompactButton" Style="{StaticResource CompactIconButton}" Click="ToggleCompact" ToolTipService.ToolTip="Compact AI Assistant" AutomationProperties.Name="Compact AI Assistant">
                    <controls:VectorIcon x:Name="CompactIcon" Symbol="chevron-down" Width="16" Height="16"/>
                </Button>
                <Button Grid.Column="2" x:Name="CloseButton" Style="{StaticResource CompactIconButton}" Click="ClosePanel" ToolTipService.ToolTip="Close" AutomationProperties.Name="Close">
                    <controls:VectorIcon Symbol="close"/>
                </Button>
            </Grid>
            <ScrollViewer x:Name="PanelContent" Grid.Row="1" Margin="0,6,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    <StackPanel x:Name="KeyBanner" Visibility="Collapsed">
                        <TextBlock x:Name="KeyHint" Text="Configure OpenAI in Settings." TextWrapping="Wrap"/>
                        <Button x:Name="KeyButton" Content="Settings" Click="OpenSettings" Style="{StaticResource AppBarButton}"/>
                    </StackPanel>
                    <StackPanel x:Name="Composer">
                        <Border x:Name="ComposerSurface" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource ShellBorder}" BorderThickness="1" CornerRadius="10" Padding="10,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid MinHeight="70">
                                    <TextBox x:Name="PromptInput" MinHeight="70" MaxHeight="180" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="16000" Style="{StaticResource ComposerTextBox}" TextChanged="PromptChanged" KeyDown="PromptKeyDown" AutomationProperties.Name="Describe how to change this Markdown"/>
                                    <TextBlock x:Name="PromptPlaceholder" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" IsHitTestVisible="False"/>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ModelButton" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource ComposerChoiceButton}" Click="OpenModelFlyout" ToolTipService.ToolTip="Choose model and reasoning effort" AutomationProperties.Name="Choose model and reasoning effort">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="ModelLabel" Text="GPT-6.1 Sol"/>
                                            <TextBlock Text=" · " Foreground="{StaticResource MutedText}" Margin="3,0"/>
                                            <TextBlock x:Name="EffortLabel" Foreground="{StaticResource MutedText}"/>
                                            <controls:VectorIcon Symbol="chevron-down" Width="12" Height="12" Margin="5,2,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="SendButton" Grid.Column="1" Style="{StaticResource ComposerSendButton}" Click="SendPrompt" ToolTipService.ToolTip="Send" AutomationProperties.Name="Send">
                                        <controls:VectorIcon x:Name="SendIcon" Symbol="send"/>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                        <Grid Margin="0,6,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="KeyboardHint" FontSize="10" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PromptCounter" Grid.Column="1" FontSize="10" Foreground="{StaticResource MutedText}" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                        <TextBlock x:Name="Status" FontSize="11" TextWrapping="Wrap" Margin="0,4"/>
                        <StackPanel x:Name="DraftActions" Orientation="Horizontal" Visibility="Collapsed">
                            <Button x:Name="UndoButton" Style="{StaticResource CompactIconButton}" Click="UndoEdit" ToolTipService.ToolTip="Undo Markdown edit" AutomationProperties.Name="Undo Markdown edit">
                                <controls:VectorIcon Symbol="undo"/>
                            </Button>
                            <Button x:Name="RedoButton" Style="{StaticResource CompactIconButton}" Click="RedoEdit" ToolTipService.ToolTip="Redo Markdown edit" AutomationProperties.Name="Redo Markdown edit">
                                <controls:VectorIcon Symbol="redo"/>
                            </Button>
                            <Button x:Name="SaveButton" Style="{StaticResource CompactIconButton}" Click="SaveEdit" ToolTipService.ToolTip="Save Markdown copy" AutomationProperties.Name="Save Markdown copy">
                                <controls:VectorIcon Symbol="save"/>
                            </Button>
                            <Button x:Name="RestoreButton" Style="{StaticResource CompactIconButton}" Click="RestoreEdit" ToolTipService.ToolTip="Restore original Markdown" AutomationProperties.Name="Restore original Markdown">
                                <controls:VectorIcon Symbol="close"/>
                            </Button>
                        </StackPanel>
                        <TextBox x:Name="ReviewText" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="240" Style="{StaticResource ComposerTextBox}" AutomationProperties.Name="AI review"/>
                        <Expander x:Name="UsageExpander" Header="Budget and usage" Style="{StaticResource MinimalExpander}" Expanded="UsageChanged" Collapsed="UsageChanged" FontSize="11" Margin="0,4,0,0">
                            <StackPanel Margin="0,8">
                                <TextBlock x:Name="CapacityLabel" TextWrapping="Wrap" FontSize="10"/>
                                <ProgressBar x:Name="ContextBar" Minimum="0" Maximum="100" Height="5" Margin="0,7" Foreground="#D5AD65"/>
                                <TextBlock x:Name="CapacityHint" FontSize="10" Foreground="{StaticResource MutedText}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="NextSend" FontSize="11" Margin="0,14,0,6"/>
                                <Grid x:Name="TokenSegments" Height="6"/>
                                <TextBlock x:Name="TokenLegend" FontSize="10" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7"/>
                                <TextBlock x:Name="SessionUsage" FontSize="10" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Popup x:Name="ModelFlyout" IsOpen="False" Closed="ModelFlyoutClosed">
                <Border x:Name="ModelFlyoutSurface" Style="{StaticResource FlyoutSurface}" Padding="14" KeyDown="FlyoutKeyDown">
                    <StackPanel>
                        <ScrollViewer MaxHeight="270" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ModelOptions"/>
                        </ScrollViewer>
                        <Border Height="1" Background="{StaticResource ShellBorder}" Margin="0,10"/>
                        <TextBlock x:Name="FlyoutEffort" FontSize="15" HorizontalAlignment="Center"/>
                        <Slider x:Name="EffortSlider" Style="{StaticResource ReasoningSlider}" Minimum="0" Maximum="4" SmallChange="1" LargeChange="1" ValueChanged="EffortChanged" Margin="0,8" AutomationProperties.Name="Reasoning effort"/>
                        <Grid>
                            <TextBlock x:Name="LowLabel" FontSize="10" Foreground="{StaticResource MutedText}"/>
                            <TextBlock x:Name="MaxLabel" FontSize="10" Foreground="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>
