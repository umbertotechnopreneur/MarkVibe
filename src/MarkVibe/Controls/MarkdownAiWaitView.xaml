<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MarkVibe.Controls.MarkdownAiWaitView">
    <Grid Background="#55111720">
        <Border Style="{StaticResource FlyoutSurface}" Width="330" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock x:Name="Title" FontSize="18"/>
                <TextBlock x:Name="Stage" TextWrapping="Wrap" Margin="0,12"/>
                <ProgressBar IsIndeterminate="True" Height="4"/>
                <Button x:Name="StopButton" Content="Stop" Click="Cancel" Margin="0,16,0,0" ToolTipService.ToolTip="Stop request"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
