<UserControl x:Class="MarkVibe.Controls.DocumentFindView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:MarkVibe.Controls"
 KeyDown="FindKeyDown">
 <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource ShellBorder}" BorderThickness="0,0,0,1" Padding="10,6">
  <Grid>
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="Auto" />
    <ColumnDefinition Width="Auto" />
    <ColumnDefinition Width="Auto" />
    <ColumnDefinition Width="Auto" />
   </Grid.ColumnDefinitions>
   <TextBox x:Name="QueryInput" Height="32" MinWidth="80" VerticalContentAlignment="Center" TextChanged="QueryChanged" AutomationProperties.Name="Find in document" ToolTipService.ToolTip="Find in document" />
   <TextBlock x:Name="MatchCount" Grid.Column="1" MinWidth="48" Margin="10,0" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" />
   <Button x:Name="PreviousButton" Grid.Column="2" Width="32" Height="32" Style="{StaticResource ToolbarButton}" Click="PreviousMatch" AutomationProperties.Name="Previous match" ToolTipService.ToolTip="Previous match" />
   <Button x:Name="NextButton" Grid.Column="3" Width="32" Height="32" Style="{StaticResource ToolbarButton}" Click="NextMatch" AutomationProperties.Name="Next match" ToolTipService.ToolTip="Next match" />
   <Button x:Name="CloseButton" Grid.Column="4" Width="32" Height="32" Style="{StaticResource ToolbarButton}" Click="CloseFind" AutomationProperties.Name="Close" ToolTipService.ToolTip="Close" />
  </Grid>
 </Border>
</UserControl>
