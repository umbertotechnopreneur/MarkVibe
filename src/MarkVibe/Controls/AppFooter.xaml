<UserControl x:Class="MarkVibe.Controls.AppFooter"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:MarkVibe.Controls"
 xmlns:toolkit="clr-namespace:System.Windows.Controls;assembly=OpenSilver.Controls.Toolkit">
 <Grid Background="Transparent" Margin="8,2" MouseEnter="PointerEntered" MouseLeave="PointerLeft" GotFocus="FocusEntered" LostFocus="FocusLeft">
  <toolkit:WrapPanel x:Name="FooterLinks" HorizontalAlignment="Center">
   <toolkit:WrapPanel Margin="4,0" VerticalAlignment="Center">
    <HyperlinkButton Content="About MarkVibe" Style="{StaticResource AppLink}" Click="ShowAbout" FontSize="10" Foreground="{StaticResource MutedText}" controls:IconLabel.HideIcon="True"/>
    <StackPanel Orientation="Horizontal">
     <TextBlock Text=" · " FontSize="10" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"/>
     <HyperlinkButton Content="Terms" Style="{StaticResource AppLink}" Click="OpenTerms" FontSize="10" Foreground="{StaticResource MutedText}" controls:IconLabel.HideIcon="True"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal">
     <TextBlock Text=" · " FontSize="10" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"/>
     <HyperlinkButton Content="Privacy" Style="{StaticResource AppLink}" Click="OpenPrivacy" FontSize="10" Foreground="{StaticResource MutedText}" controls:IconLabel.HideIcon="True"/>
    </StackPanel>
   </toolkit:WrapPanel>
   <StackPanel Orientation="Horizontal" Margin="12,0,4,0" VerticalAlignment="Center">
    <TextBlock Text="This is VibeWare · " FontSize="10" Foreground="{StaticResource MutedText}" VerticalAlignment="Center"/>
    <HyperlinkButton Content="Manifesto" Style="{StaticResource AppLink}" Click="OpenManifesto" FontSize="10" Foreground="{StaticResource MutedText}" controls:IconLabel.HideIcon="True"/>
   </StackPanel>
  </toolkit:WrapPanel>
 </Grid>
</UserControl>
