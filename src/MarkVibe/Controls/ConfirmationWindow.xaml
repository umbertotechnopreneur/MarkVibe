<ChildWindow x:Class="MarkVibe.Controls.ConfirmationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:MarkVibe.Controls"
 Title="Are you sure?" Width="460" Height="238" Style="{StaticResource AppDialog}">
 <Grid Margin="24,8,24,20">
  <Grid.RowDefinitions>
   <RowDefinition Height="*" />
   <RowDefinition Height="Auto" />
  </Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14"/>
    <Border x:Name="TargetSurface" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource ShellBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0">
     <TextBlock x:Name="TargetText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
    </Border>
    <TextBlock x:Name="DetailsText" Foreground="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
   <Button x:Name="CancelButton" Content="Cancel" Click="Cancel"
           controls:IconLabel.HideIcon="True" controls:IconLabel.HideToolTip="True"
           Style="{StaticResource ToolbarButton}" />
   <Button x:Name="ConfirmButton" Click="Confirm"
           controls:IconLabel.HideIcon="True" controls:IconLabel.HideToolTip="True"
           Style="{StaticResource DialogPrimaryButton}" />
  </StackPanel>
 </Grid>
</ChildWindow>
