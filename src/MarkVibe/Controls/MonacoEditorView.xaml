<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:MarkVibe.Controls" x:Class="MarkVibe.Controls.MonacoEditorView">
    <Border Style="{StaticResource ComposerSurface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="{StaticResource AcrylicPanel}" CornerRadius="12,12,0,0" Padding="12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SourcePath" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="SourceSearch" Grid.Column="1" Style="{StaticResource ComposerTextBox}" VerticalAlignment="Center" TextChanged="FindSource" AutomationProperties.Name="Find in source" ToolTipService.ToolTip="Find in source" Margin="4,0,10,0"/>
                    <Button x:Name="SimpleButton" Grid.Column="2" Style="{StaticResource CompactIconButton}" Click="ToggleSimple" ToolTipService.ToolTip="Simple view" AutomationProperties.Name="Simple view">
                        <controls:VectorIcon Symbol="simple"/>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource CompactIconButton}" Click="CopySource" ToolTipService.ToolTip="Copy" AutomationProperties.Name="Copy">
                        <controls:VectorIcon Symbol="copy"/>
                    </Button>
                </Grid>
            </Border>
            <controls:SourceRenderer x:Name="Renderer" Grid.Row="1"/>
        </Grid>
    </Border>
</UserControl>
