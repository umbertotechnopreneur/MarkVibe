<UserControl x:Class="MarkVibe.Controls.ReaderAppearanceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Margin="10,0,10,8">
  <TextBlock Text="LIGHT DOCUMENT THEME" Style="{StaticResource DialogSectionLabel}" />
  <ComboBox x:Name="LightDocumentThemeCombo" Height="38" Tag="lightDocumentTheme" SelectionChanged="ThemeChanged" AutomationProperties.Name="LIGHT DOCUMENT THEME" />
  <TextBlock Text="DARK DOCUMENT THEME" Style="{StaticResource DialogSectionLabel}" />
  <ComboBox x:Name="DarkDocumentThemeCombo" Height="38" Tag="darkDocumentTheme" SelectionChanged="ThemeChanged" AutomationProperties.Name="DARK DOCUMENT THEME" />
  <TextBlock Text="LIGHT CODE THEME" Style="{StaticResource DialogSectionLabel}" />
  <ComboBox x:Name="LightCodeThemeCombo" Height="38" Tag="lightCodeTheme" SelectionChanged="ThemeChanged" AutomationProperties.Name="LIGHT CODE THEME" />
  <TextBlock Text="DARK CODE THEME" Style="{StaticResource DialogSectionLabel}" />
  <ComboBox x:Name="DarkCodeThemeCombo" Height="38" Tag="darkCodeTheme" SelectionChanged="ThemeChanged" AutomationProperties.Name="DARK CODE THEME" />
  <CheckBox x:Name="UnderlineLinksCheck" Content="Underline hyperlinks" Margin="0,16,0,4" Checked="UnderlineChanged" Unchecked="UnderlineChanged" />
  <TextBlock Text="DOCUMENT FONT" Style="{StaticResource DialogSectionLabel}" />
  <ComboBox x:Name="DocumentFontCombo" Height="38" Tag="documentFont" SelectionChanged="ThemeChanged" IsEnabled="False" AutomationProperties.Name="DOCUMENT FONT" />
  <TextBlock Text="These reading choices are saved for this folder." TextWrapping="Wrap" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" />
  <Button Content="Use global reading defaults" Style="{StaticResource ToolbarButton}" Margin="0,10,0,0" Click="ResetFolderAppearance" />
 </StackPanel>
</UserControl>
