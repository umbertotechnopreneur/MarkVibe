<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:MarkVibe.Controls">
    <Style x:Key="ComposerSurface" TargetType="Border">
        <Setter Property="controls:Backdrop.BlurRadius" Value="16"/>
        <Setter Property="Background" Value="{StaticResource AcrylicPanel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style x:Key="FlyoutSurface" TargetType="Border" BasedOn="{StaticResource ComposerSurface}">
        <Setter Property="Effect" Value="{StaticResource DialogElevation16}"/>
    </Style>
    <Style x:Key="CompactIconButton" TargetType="Button" BasedOn="{StaticResource AppBarButton}">
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Margin" Value="0"/>
    </Style>
    <Style x:Key="ComposerChoiceButton" TargetType="Button" BasedOn="{StaticResource AppBarButton}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="0,6,8,6"/>
        <Setter Property="Margin" Value="0"/>
    </Style>
    <Style x:Key="FlyoutChoiceButton" TargetType="Button" BasedOn="{StaticResource AppBarButton}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0,9"/>
        <Setter Property="Margin" Value="0"/>
    </Style>
    <Style x:Key="FileMenuButton" TargetType="Button" BasedOn="{StaticResource FlyoutChoiceButton}">
        <Setter Property="Padding" Value="10,9"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Grid x:Name="FileActionRoot" Background="Transparent">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="MouseOver"><Storyboard><DoubleAnimation Storyboard.TargetName="FileActionHover" Storyboard.TargetProperty="Opacity" To="0.1" Duration="0"/></Storyboard></VisualState>
                        <VisualState x:Name="Pressed"><Storyboard><DoubleAnimation Storyboard.TargetName="FileActionHover" Storyboard.TargetProperty="Opacity" To="0.18" Duration="0"/></Storyboard></VisualState>
                        <VisualState x:Name="Disabled"><Storyboard><DoubleAnimation Storyboard.TargetName="FileActionRoot" Storyboard.TargetProperty="Opacity" To="0.38" Duration="0"/></Storyboard></VisualState>
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Unfocused"/>
                        <VisualState x:Name="Focused"><Storyboard><DoubleAnimation Storyboard.TargetName="FileActionFocus" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/></Storyboard></VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
                <Border x:Name="FileActionHover" Background="{StaticResource SystemAccent}" CornerRadius="6" Opacity="0"/>
                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                <Border x:Name="FileActionFocus" CornerRadius="6" BorderBrush="{StaticResource SystemAccent}" BorderThickness="1" Opacity="0" IsHitTestVisible="False"/>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="AppearanceChoiceButton" TargetType="Button" BasedOn="{StaticResource FileMenuButton}">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="MinWidth" Value="34"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Margin" Value="2"/>
    </Style>
    <Style x:Key="ComposerSendButton" TargetType="Button" BasedOn="{StaticResource CompactIconButton}">
        <Setter Property="Background" Value="#236F52"/>
        <Setter Property="Foreground" Value="#D6F4E5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="SendSurface" CornerRadius="16" Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver"/>
                                <VisualState x:Name="Pressed"/>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SendSurface" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter Content="{TemplateBinding Content}" Margin="6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ComposerTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ShellText}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="ContentElement" Padding="{TemplateBinding Padding}" BorderThickness="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Retain Slider's standard parts so keyboard, pointer capture and automation stay native. -->
    <ControlTemplate x:Key="ReasoningTrackButton" TargetType="RepeatButton">
        <Border Background="Transparent"/>
    </ControlTemplate>
    <Style x:Key="ReasoningSlider" TargetType="Slider">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="HorizontalTemplate" Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="3" Height="28" CornerRadius="14" Background="{StaticResource ShellBorder}" Opacity="0.65"/>
                        <Border Grid.ColumnSpan="2" Height="28" CornerRadius="14" Background="{TemplateBinding Foreground}"/>
                        <Border Grid.ColumnSpan="2" Height="28" CornerRadius="14" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                                    <GradientStop Color="#28FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <RepeatButton x:Name="HorizontalTrackLargeChangeDecreaseRepeatButton" IsTabStop="False" Template="{StaticResource ReasoningTrackButton}"/>
                        <Thumb x:Name="HorizontalThumb" Grid.Column="1" Width="32" Height="32" IsTabStop="False">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Ellipse Fill="{StaticResource ShellText}"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                        <RepeatButton x:Name="HorizontalTrackLargeChangeIncreaseRepeatButton" Grid.Column="2" IsTabStop="False" Template="{StaticResource ReasoningTrackButton}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MinimalExpander" TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource ShellText}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ExpansionStates">
                                <VisualState x:Name="Collapsed"/>
                                <VisualState x:Name="Expanded">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ExpanderContent" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Left" BorderThickness="0" Background="Transparent" Foreground="{TemplateBinding Foreground}" Padding="0,6">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Background="Transparent">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CheckStates">
                                                <VisualState x:Name="Unchecked"/>
                                                <VisualState x:Name="Checked">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="DisclosureRotation" Storyboard.TargetProperty="Angle" To="0" Duration="0"/>
                                                    </Storyboard>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <controls:VectorIcon Symbol="chevron-down" Width="12" Height="12" VerticalAlignment="Center">
                                            <controls:VectorIcon.RenderTransform>
                                                <RotateTransform x:Name="DisclosureRotation" Angle="180" CenterX="6" CenterY="6"/>
                                            </controls:VectorIcon.RenderTransform>
                                        </controls:VectorIcon>
                                        <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                                    </Grid>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ContentPresenter Content="{TemplateBinding Header}"/>
                        </ToggleButton>
                        <ContentPresenter x:Name="ExpanderContent" Content="{TemplateBinding Content}" Visibility="Collapsed"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
