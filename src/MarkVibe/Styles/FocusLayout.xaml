<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="FocusHeader" TargetType="Border">
  <Setter Property="Background" Value="{StaticResource AcrylicPanel}" />
  <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}" />
  <Setter Property="BorderThickness" Value="0,0,0,1" />
 </Style>
 <Style x:Key="FocusSidebar" TargetType="Border">
  <Setter Property="Background" Value="{StaticResource AcrylicPanel}" />
  <Setter Property="BorderThickness" Value="0" />
 </Style>
 <Style x:Key="FocusViewButton" TargetType="Button" BasedOn="{StaticResource ViewButton}">
  <Setter Property="FontSize" Value="12" />
  <Setter Property="FontWeight" Value="SemiLight" />
  <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}" />
  <Setter Property="BorderThickness" Value="1" />
  <Setter Property="Background" Value="{StaticResource PanelBackground}" />
  <Setter Property="MinHeight" Value="36" />
  <Setter Property="Padding" Value="12,8" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid x:Name="ViewTabRoot" Background="Transparent">
    <VisualStateManager.VisualStateGroups>
     <VisualStateGroup x:Name="CommonStates">
      <VisualState x:Name="Normal" />
      <VisualState x:Name="MouseOver"><Storyboard><DoubleAnimation Storyboard.TargetName="TabHover" Storyboard.TargetProperty="Opacity" To="0.09" Duration="0:0:0.12" /></Storyboard></VisualState>
      <VisualState x:Name="Pressed"><Storyboard><DoubleAnimation Storyboard.TargetName="TabHover" Storyboard.TargetProperty="Opacity" To="0.16" Duration="0" /></Storyboard></VisualState>
      <VisualState x:Name="Disabled"><Storyboard><DoubleAnimation Storyboard.TargetName="ViewTabRoot" Storyboard.TargetProperty="Opacity" To="0.38" Duration="0" /></Storyboard></VisualState>
     </VisualStateGroup>
     <VisualStateGroup x:Name="FocusStates">
      <VisualState x:Name="Unfocused" />
      <VisualState x:Name="Focused"><Storyboard><DoubleAnimation Storyboard.TargetName="TabFocus" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard></VisualState>
     </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
    <Border x:Name="TabHover" CornerRadius="8" Background="{StaticResource SystemAccent}" Opacity="0" IsHitTestVisible="False" />
    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
     Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    <Border x:Name="TabFocus" CornerRadius="10" Margin="-2" BorderBrush="{StaticResource SystemAccent}" BorderThickness="1" Opacity="0" IsHitTestVisible="False" />
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
