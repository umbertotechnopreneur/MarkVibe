<ChildWindow x:Class="MarkVibe.AboutWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="About MarkVibe" Width="620" Height="610" HasCloseButton="True" Foreground="{StaticResource ShellText}">
 <Grid Background="{StaticResource PanelBackground}">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="24,20">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
     <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource Accent}" Margin="0,0,16,0"><TextBlock Text="M" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <StackPanel VerticalAlignment="Center"><TextBlock Text="MarkVibe" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Read. Annotate. Keep it yours." FontSize="13" Foreground="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel>
    </StackPanel>
    <TextBlock Text="I created MarkVibe because I was frustrated by the Markdown readers I tried: I could read, but taking handwritten notes or getting a useful PDF or HTML export meant extra tools, awkward steps, or a different operating system." FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <TextBlock Text="I wanted one place to read my local documents, write notes and save a portable copy. MarkVibe keeps ink in a separate file and exports the current page with its images and diagrams." FontSize="14" TextWrapping="Wrap" Margin="0,0,0,16"/>
    <Border Background="{StaticResource AccentSoft}" CornerRadius="8" Padding="14" Margin="0,0,0,16"><StackPanel><TextBlock x:Name="VersionText" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="BuiltText" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Border>
    <TextBlock Text="I release MarkVibe as free software under the MIT license. You may use, change, share or sell it, keeping the copyright and license notice." FontSize="13" TextWrapping="Wrap" Margin="0,0,0,14"/>
    <Button Content="Umberto Giacobbi" Style="{StaticResource ToolbarButton}" Click="Author" HorizontalAlignment="Left" Margin="0,4"/>
    <Button Content="GitHub repository" Style="{StaticResource ToolbarButton}" Click="Repository" HorizontalAlignment="Left" Margin="0,4"/>
    <Button Content="MIT license" Style="{StaticResource ToolbarButton}" Click="License" HorizontalAlignment="Left" Margin="0,4"/>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="1" BorderBrush="{StaticResource ShellBorder}" BorderThickness="0,1,0,0" Padding="20,14">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="VibeWare" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Human intent, AI execution, and plenty of tokens" FontSize="11" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,8,8"/><Button Content="VibeWare manifesto" Style="{StaticResource ViewButton}" Click="Manifesto" HorizontalAlignment="Left"/></StackPanel>
    <Button Grid.Column="1" Content="Close" Style="{StaticResource ToolbarButton}" Click="Dismiss" VerticalAlignment="Bottom"/>
   </Grid>
  </Border>
 </Grid>
</ChildWindow>
